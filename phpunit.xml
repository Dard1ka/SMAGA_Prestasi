<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": compose injects the dev .env (APP_ENV=local, DB_CONNECTION=mysql) into the container.
             Without force, RefreshDatabase would wipe the dev MySQL database. Tests always use in-memory SQLite. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- The runtime switches keep their test defaults, also when a developer's .env turns them off (the test
             process reads .env too). Tests of the "off" state boot their own app (tests/Support/ProcessEnv.php).
             STH_REQUIRE_STAFF_2FA=true is what config/fortify.php gives every APP_ENV but local. -->
        <env name="STH_STAFF_2FA" value="true" force="true"/>
        <env name="STH_REQUIRE_STAFF_2FA" value="true" force="true"/>
        <env name="STH_DEV_PAGES" value="true" force="true"/>
        <!-- Empty on purpose: the tests use the built-in default of config/sth.php, never a developer .env value (D-138). -->
        <env name="STH_INITIAL_STUDENT_PASSWORD" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
