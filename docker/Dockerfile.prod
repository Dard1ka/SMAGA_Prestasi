# syntax=docker/dockerfile:1
# SMAGA Talent Hub: production images (docs/DEPLOY.md, docs/SECURITY.md §3j/§3k).
#
#   docker build -f docker/Dockerfile.prod -t sth-app:prod .              php-fpm app (last stage = default target)
#   docker build -f docker/Dockerfile.prod --target web -t sth-web:prod .  nginx + public/ assets
#
# docker/compose.prod.yaml builds both. Stages: php-ext (extensions) → vendor (composer, no dev) →
# assets (npm ci + vite build) → web (nginx) → app (php-fpm runtime, non-root, read-only friendly).
# Base images are pinned by digest; Dependabot (.github/dependabot.yml) proposes digest bumps.
# No .env, secrets or storage data ever enter the image (.dockerignore); configuration arrives at runtime.

########################################################################################################
# php-ext: same extensions as the dev image (docker/php/Dockerfile, stage base), compiled once.
########################################################################################################
FROM php:8.4-fpm-bookworm@sha256:b75642e8c89c321039f351466134df951576fb0f7017117b3931e9a19b908d6c AS php-ext

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev libwebp-dev libfreetype6-dev \
 && docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql intl zip gd bcmath exif opcache pcntl \
 && rm -rf /var/lib/apt/lists/*

########################################################################################################
# vendor: production Composer dependencies + authoritative classmap over the application source.
########################################################################################################
FROM php-ext AS vendor

COPY --from=composer:2@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1
WORKDIR /app

# Dependencies first (layer cache survives source-only changes). Scripts are skipped: artisan does not exist yet.
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress

COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-scripts \
 && composer check-platform-reqs --no-dev \
 && rm -rf docker

########################################################################################################
# assets: Vite/Tailwind build. Node exists only in this stage (the Ubuntu 18.04 host never runs Node).
########################################################################################################
FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS assets

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --no-audit --no-fund

# Full source + vendor: Tailwind scans Blade/PHP files for class names (and @source paths into vendor/).
COPY --from=vendor /app/ ./
RUN npm run build \
 && test -f public/build/manifest.json

########################################################################################################
# web: nginx serving public/ and forwarding /index.php to app:9000 (docker/nginx/prod.conf).
########################################################################################################
FROM nginxinc/nginx-unprivileged:1.30-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03 AS web

# Security fixes that are newer than the pinned base image (CI: Trivy fails on fixable HIGH/CRITICAL). List only the
# packages Trivy names, and drop one again once a newer base digest already contains the fix (pcre2, tiff and libx11
# of 2026-10 were dropped on 2026-11-10: the base digest of that day ships the fixed versions).
#   libexpat 2.10.0-r0: CVE-2026-113351, CVE-2026-115506, CVE-2026-117610, CVE-2026-118370 (base has 2.9.0-r0;
#     first added 2026-10-19 for CVE-2026-77214, which the base now has)
#   brotli-libs 1.2.1-r0: CVE-2026-111497; curl, libcurl 8.23.0-r0: CVE-2026-92392;
#   musl, musl-utils 1.2.6-r3: CVE-2026-107891; zlib 1.3.2-r1: CVE-2026-85091 (added 2026-11-10)
USER root
RUN apk upgrade --no-cache libexpat brotli-libs curl libcurl musl musl-utils zlib
USER 101

COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=vendor /app/public/ /var/www/html/public/
COPY --from=assets /app/public/build/ /var/www/html/public/build/
RUN nginx -t

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-health || exit 1

########################################################################################################
# app: php-fpm runtime. Code is root-owned and read-only for www-data; only storage/ and bootstrap/cache
# are writable (a volume and a tmpfs in compose). Runs with read_only: true.
########################################################################################################
FROM php:8.4-fpm-bookworm@sha256:b75642e8c89c321039f351466134df951576fb0f7017117b3931e9a19b908d6c AS app

# Runtime libraries of the compiled extensions (no -dev packages, no compilers) + cgi-fcgi for the healthcheck.
# Security fixes that are newer than the pinned base image (same rule as the web stage: only the packages Trivy
# names, and drop one again once a newer base digest already contains the fix). None needed since 2026-11-10: the
# base digest of that day ships libpcre2-8-0, the perl packages and linux-libc-dev at the fixed versions, so the
# `apt-get install -y --no-install-recommends --only-upgrade <package>` step is gone until Trivy names a package again.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libicu72 libzip4 libpng16-16 libjpeg62-turbo libwebp7 libfreetype6 libfcgi-bin \
 && rm -rf /var/lib/apt/lists/*

COPY --from=php-ext /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-ext /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/php.ini /usr/local/etc/php/conf.d/zz-sth.ini
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zzz-sth-prod.ini
COPY docker/php/fpm-pool.prod.conf /usr/local/etc/php-fpm.d/zzz-sth-pool.conf
COPY --chmod=0755 docker/php/entrypoint.prod.sh /usr/local/bin/sth-entrypoint
COPY --chmod=0755 docker/php/healthcheck.sh /usr/local/bin/sth-healthcheck

# Fail the build if an extension lost a shared library or did not load.
RUN ! ldd /usr/local/lib/php/extensions/*/*.so | grep -q 'not found' \
 && for ext in pdo_mysql intl zip gd bcmath exif pcntl "Zend OPcache"; do \
      php -m | grep -qix "$ext" || { echo "missing PHP extension: $ext" >&2; exit 1; }; \
    done \
 && php-fpm -t

WORKDIR /var/www/html

COPY --from=vendor /app/ ./
COPY --from=assets /app/public/build/ ./public/build/

# The base image ships /var/www/html as www-data:1777; make the code root directory root-owned and read-only.
RUN chown root:root /var/www/html && chmod 0755 /var/www/html \
 && mkdir -p storage/app/private storage/app/public \
             storage/framework/cache/data storage/framework/sessions storage/framework/views \
             storage/logs bootstrap/cache \
 && chown -R www-data:www-data storage bootstrap/cache \
 && chmod -R u=rwX,g=rX,o= storage bootstrap/cache

USER www-data

# Smoke test: the application boots without any .env (all config comes from the environment at runtime).
# APP_ENV=build only for this step: with the framework default (production) AppServiceProvider rightly refuses
# to boot because MAIL_MAILER falls back to "log".
RUN APP_ENV=build php artisan package:discover --ansi \
 && APP_ENV=build php artisan --version

ENTRYPOINT ["sth-entrypoint"]
CMD ["php-fpm"]
EXPOSE 9000
STOPSIGNAL SIGQUIT
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD ["sth-healthcheck"]
