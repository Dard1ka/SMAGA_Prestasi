# SMAGA Talent Hub: production .env TEMPLATE (docs/DEPLOY.md §7). Placeholders only, no real secrets.
# On the server: cp docker/env.production.example .env && chmod 600 .env, then replace every CHANGE_ME.
# Read by docker/compose.prod.yaml as env_file for app, queue and scheduler (never baked into the image).
# Compose forces APP_ENV=production and APP_DEBUG=false on top of this file.
# Do NOT add STH_OTP_TEST_MODE / STH_OTP_DEV_BYPASS here, not even "=false" (CLAUDE.md rule 7, SECURITY §3b).
# Values: no quotes needed; never use "$" or "#" in secrets (generate them with `openssl rand -hex 32`).

APP_NAME="SMAGA Talent Hub"
APP_ENV=production
APP_DEBUG=false
# Generate ON THE SERVER, unique per environment, never copied from dev/CI:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE_ME
APP_URL=https://prestasi.sman3-smg.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Runtime DB user = DML only (docker/mysql/initdb/10-app-user.sh). DB_PASSWORD must equal secrets/db_app_password.txt.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sth
DB_USERNAME=sth_app
DB_PASSWORD=CHANGE_ME

# Subdomain session hardening (SECURITY §3e): __Host- prefix = Secure + Path=/ + no Domain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=__Host-sth_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Gateway of the compose `edge` network: the only address TrustProxies trusts (docker/compose.prod.yaml).
STH_TRUSTED_PROXY=172.30.10.1

# Staff roles must enrol TOTP 2FA (SECURITY §3a).
STH_REQUIRE_STAFF_2FA=true

# Live counts (D-127): every open page asks GET /notifikasi/jumlah for the bell and the sidebar counts, about once per
# this many seconds while its tab is visible and in use (default 60; 1 to 29 are read as 30, above 3600 as 3600). Each
# check is a full request to php-fpm (pm.max_children = 12): raise the value when the pool is busy. To switch the checks
# off set 0, never a very large number.
# STH_COUNTS_POLL_SECONDS=60

# Initial password of every newly imported student (D-138): hashed at import, never shown or logged. Empty = the
# default in config/sth.php. Students must replace it at the first login. Set the value the school chose here only
# (never in the repo); unset = the default in config/sth.php.
# STH_INITIAL_STUDENT_PASSWORD=

# Mail: noreply is set up later by the deploy team (D-15). Until then these stay placeholders and outgoing mail
# jobs fail visibly in failed_jobs. MAIL_MAILER log/array is refused in production (AppServiceProvider).
# Example for Google Workspace SMTP relay: MAIL_HOST=smtp-relay.gmail.com MAIL_PORT=587 MAIL_SCHEME=smtp
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=noreply@sman3-smg.sch.id
MAIL_FROM_NAME="SMAGA Talent Hub"
