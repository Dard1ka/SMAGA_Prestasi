APP_NAME="SMAGA Talent Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sth
DB_USERNAME=sth
DB_PASSWORD=sth_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sman3-smg.sch.id"
MAIL_FROM_NAME="SMAGA Talent Hub"
# Real mail from a local stack (optional, D-121; steps in docs/dev-notes/EM1.md). Never commit a filled .env.
# Without these lines every mail stays in Mailpit (http://127.0.0.1:8025), which is the normal way to work.
# To switch it on, remove the leading "#   " of the lines below and fill in the empty values (after the "=").
#   MAIL_MAILER=allowlist          # only mail for the addresses below goes out, everything else stays in Mailpit
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=                 # "Login" on Brevo > Settings > SMTP & API, looks like 1234abc@smtp-brevo.com
#   MAIL_PASSWORD=                 # the SMTP key, not the API key
#   MAIL_FROM_ADDRESS=             # the sender verified in Brevo, exactly as typed there
#   STH_MAIL_ALLOWLIST=you@example.test,you+*@example.test   # your own inboxes; * only in the part before the @
#   A single * as the whole value (STH_MAIL_ALLOWLIST=*) opens it (D-130): every address that can exist gets real
#   mail, fictional ones (name@sth.test, example.com, .test, .invalid) still stay in Mailpit. Mind the provider's quota.
#   The * only counts when every other entry is a valid one: "* @gmail.com" stays closed (sth:mail-test says so).
# A provider login under MAIL_MAILER=smtp is refused at boot while APP_ENV=local: the scheduler and the demo data
# write to fictional addresses (name@sth.test), which bounce at the provider. A mail sent by name through such a
# mailer (e.g. one queued before the switch) is dropped with a warning in the log. After a change: reload.bat, then
# docker compose restart queue scheduler.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
STH_OTP_TEST_MODE=true

# Live counts (D-127): an open page asks the server for the bell and the sidebar counts. Seconds between two
# background checks of one page; 60 when unset, 1 to 29 are read as 30, above 3600 as 3600. 0 switches the checks
# off and is the only way to do so (the bell then changes on a page load and after "Tandai dibaca" only). After a
# change: reload.bat.
# STH_COUNTS_POLL_SECONDS=60

# Initial password of every newly imported student (D-138): hashed at import, never shown or logged. Empty = the
# default in config/sth.php. Students must replace it at the first login. After a change: reload.bat.
# STH_INITIAL_STUDENT_PASSWORD=

# Staff 2FA (TOTP). false = two-factor authentication does not exist in the app at all, for every account: no code
# at login, no /akun/2fa, no 2FA on any screen, and STH_REQUIRE_STAFF_2FA is ignored. true when unset (the security
# baseline, docs/SECURITY.md §3a). After a change: reload.bat.
# STH_STAFF_2FA=true

# Developer pages under /_dev (component showcase), loaded only when APP_ENV=local. false = every /_dev address
# answers 404 on this local stack too (e.g. a demo shown to other people). true when unset. After a change: reload.bat.
# STH_DEV_PAGES=true
